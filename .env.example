APP_NAME="TuNegocio Citas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=America/Mexico_City

# Cuenta de la dueña en el panel (la crea db:seed). Nunca subir valores reales.
PANEL_ADMIN_EMAIL=
PANEL_ADMIN_PASSWORD=
PANEL_ADMIN_NOMBRE=

NEGOCIO_NOMBRE="TuNegocio Citas"
NEGOCIO_DIRECCION=

# WhatsApp Cloud API (Meta) — usar solo el número de prueba.
# Nunca subir valores reales: el .env está excluido del control de versiones.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
# Secreto de la app (Meta > Configuración de la app > Básica). Obligatorio en producción:
# sin él el webhook rechaza todos los POST.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_BOT_ACTIVO=true
WHATSAPP_COSTO_MARKETING_USD=0.0397
TIPO_CAMBIO_USD_MXN=18.5
WHATSAPP_NUMERO_PUBLICO=

# IA para entender texto libre en WhatsApp. Vacío = el bot funciona solo con botones.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
